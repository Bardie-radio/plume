@page "/claim/bind"
@model Plume.Pages.Claim.BindModel
@{
    ViewData["Title"] = "Link sign-in method";
}

<section class="mx-auto max-w-md space-y-6 py-8">
    <header class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Link sign-in method</h1>
        <p class="text-sm text-neutral-600">
            Choose how you will sign in after registration. Fill in the provider binding form on the next step.
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <p class="text-red-700" role="alert">@Model.LoadError</p>
    }
    else if (Model.Providers.Count > 0)
    {
        <ul class="space-y-3">
            @foreach (var provider in Model.Providers)
            {
                var label = string.IsNullOrWhiteSpace(provider.DisplayName) ? provider.Id : provider.DisplayName;
                <li>
                    <a class="block w-full border border-neutral-800 bg-neutral-900 px-4 py-3 text-center text-sm text-white"
                       href="/claim/bind/@Uri.EscapeDataString(provider.Id)">
                        @label
                    </a>
                </li>
            }
        </ul>
    }
</section>
