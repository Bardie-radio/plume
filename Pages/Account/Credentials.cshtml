@page "/account/credentials"
@model Plume.Pages.Account.CredentialsModel
@{
    var providerTitle = Model.ProviderDisplayName;
    var pageTitle = string.IsNullOrWhiteSpace(providerTitle)
        ? "Update your account data"
        : $"Update your {providerTitle} data";
    ViewData["Title"] = pageTitle;
}

<section class="mx-auto max-w-md space-y-6 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">@pageTitle</h1>
    <p class="text-sm text-neutral-600">
        Edit binding data for this provider. Saving asks you to authenticate again with the same method you use to sign in — then applies only the fields below.
    </p>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <p class="text-red-700" role="alert">@Model.LoadError</p>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-700" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.BindFields.Count > 0)
    {
        <form id="bind-update-form" method="post" class="space-y-4"
              data-provider-id="@Model.ProviderId"
              data-step-up="@(Model.UsesLoginFormStepUp ? "login_form" : Model.UsesRedirectStepUp ? "redirect" : "none")"
              data-authorize-url="@(Model.AuthorizeUrl ?? "")">
            <input type="hidden" asp-for="ProviderId" />
            <input type="hidden" asp-for="ReturnUrl" />

            @foreach (var field in Model.BindFields)
            {
                var inputType = string.IsNullOrWhiteSpace(field.InputType) ? "text" : field.InputType;
                var fieldId = $"field_{field.Name}";
                var isSecret = string.Equals(inputType, "password", StringComparison.OrdinalIgnoreCase);
                <div class="space-y-1">
                    <label class="block text-sm" for="@fieldId">@field.Label</label>
                    <input
                        class="w-full border border-neutral-300 px-3 py-2"
                        id="@fieldId"
                        name="field_@field.Name"
                        type="@inputType"
                        required="@field.Required"
                        autocomplete="@(isSecret ? "new-password" : "on")" />
                </div>
            }

            <button type="submit" class="border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm text-white">
                Save changes
            </button>
        </form>

        @if (Model.UsesLoginFormStepUp || Model.UsesRedirectStepUp)
        {
            <dialog id="bind-reauth-dialog" class="w-full max-w-sm border border-neutral-300 bg-white p-6 text-neutral-900 shadow-lg backdrop:bg-neutral-900/40">
                <div class="space-y-4">
                    <h2 class="text-lg font-semibold tracking-tight">Authenticate with @providerTitle</h2>
                    <p class="text-sm text-neutral-600">
                        Confirm it is still you. This uses the provider sign-in flow — not the binding fields above.
                    </p>
                    <p id="bind-reauth-error" class="hidden text-sm text-red-700" role="alert"></p>

                    @if (Model.UsesLoginFormStepUp)
                    {
                        <form id="bind-reauth-form" class="space-y-4">
                            @foreach (var field in Model.LoginFields)
                            {
                                var inputType = string.IsNullOrWhiteSpace(field.InputType) ? "text" : field.InputType;
                                var fieldId = $"reauth_{field.Name}";
                                var isSecret = string.Equals(inputType, "password", StringComparison.OrdinalIgnoreCase);
                                <div class="space-y-1">
                                    <label class="block text-sm" for="@fieldId">@field.Label</label>
                                    <input
                                        class="w-full border border-neutral-300 px-3 py-2"
                                        id="@fieldId"
                                        name="@field.Name"
                                        type="@inputType"
                                        required="@field.Required"
                                        autocomplete="@(isSecret ? "current-password" : "username")" />
                                </div>
                            }

                            <div class="flex justify-end gap-3 pt-2">
                                <button type="button" id="bind-reauth-cancel" class="border border-neutral-300 px-3 py-2 text-sm">
                                    Cancel
                                </button>
                                <button type="submit" class="border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-white">
                                    Authenticate
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="flex justify-end gap-3 pt-2">
                            <button type="button" id="bind-reauth-cancel" class="border border-neutral-300 px-3 py-2 text-sm">
                                Cancel
                            </button>
                            <a class="border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-white" href="@Model.AuthorizeUrl">
                                Continue
                            </a>
                        </div>
                    }
                </div>
            </dialog>
        }
    }
</section>

@section Scripts {
    <script type="module" src="~/dist/assets/credentials-reauth.js" asp-append-version="true"></script>
}
