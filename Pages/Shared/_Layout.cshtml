<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plume</title>
    <link rel="stylesheet" href="~/dist/assets/main.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    <header class="flex items-center justify-between border-b border-neutral-200 px-4 py-3">
        <p class="font-medium tracking-tight">
            <a href="@(User.Identity?.IsAuthenticated == true
                && string.Equals(User.FindFirst("bardie_provider")?.Value, "kithara.claim", StringComparison.Ordinal)
                ? "/claim/bind"
                : "/")">Plume</a>
        </p>
        <nav class="flex items-center gap-4 text-sm">
            @{
                var isClaimSession = User.Identity?.IsAuthenticated == true
                    && string.Equals(
                        User.FindFirst("bardie_provider")?.Value,
                        "kithara.claim",
                        StringComparison.Ordinal);
            }
            @if (isClaimSession)
            {
                <a class="underline underline-offset-2" href="/claim/bind">Finish registration</a>
                <form method="post" action="/bff/auth/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="underline underline-offset-2">Cancel</button>
                </form>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <a class="underline underline-offset-2" href="/account/credentials">Account</a>
                @if (User.IsInRole("admin"))
                {
                    <a class="underline underline-offset-2" href="/account/invite">Invite user</a>
                }
                <form method="post" action="/bff/auth/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="underline underline-offset-2">Log out</button>
                </form>
            }
            else
            {
                <a class="underline underline-offset-2" href="/claim">Complete registration</a>
                <a class="underline underline-offset-2" href="/login">Log in</a>
            }
        </nav>
    </header>
    <main class="px-4">
        @RenderBody()
    </main>
    @*
      Vue islands: mark host nodes with data-plume-island="<name>"
      (now-playing | transport | queue | search | audio | listen) plus
      data-struna-id / data-struna-slug (and optional data-variant / data-stream-url /
      data-playback-access). now-playing variant is code-selected: compact (control) vs prominent.
      main.js mounts them after the document is parsed.
    *@
    <script type="module" src="~/dist/assets/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
