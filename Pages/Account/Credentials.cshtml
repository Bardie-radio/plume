@page "/account/credentials"
@model Plume.Pages.Account.CredentialsModel
@{
    ViewData["Title"] = "Update credentials";
}

<section class="mx-auto max-w-md space-y-6 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">Update credentials</h1>
    <p class="text-sm text-neutral-600">
        Change your password before using control features. This uses the provider
        <code>bind_form</code> — not the login form.
    </p>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <p class="text-red-700" role="alert">@Model.LoadError</p>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-700" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.Provider is { BindForm: { Count: > 0 } } provider)
    {
        <form method="post" class="space-y-4">
            <input type="hidden" asp-for="ProviderId" />
            <input type="hidden" asp-for="ReturnUrl" />

            @foreach (var field in provider.BindForm)
            {
                var inputType = string.IsNullOrWhiteSpace(field.InputType) ? "text" : field.InputType;
                var fieldId = $"field_{field.Name}";
                var isNewPassword = string.Equals(field.Name, "new_password", StringComparison.OrdinalIgnoreCase);
                <div class="space-y-1">
                    <label class="block text-sm" for="@fieldId">@field.Label</label>
                    <input
                        class="w-full border border-neutral-300 px-3 py-2"
                        id="@fieldId"
                        name="field_@field.Name"
                        type="@inputType"
                        required="@(field.Required || isNewPassword)"
                        autocomplete="@(isNewPassword ? "new-password" : (string.Equals(inputType, "password", StringComparison.OrdinalIgnoreCase) ? "current-password" : "username"))" />
                </div>
            }

            <button type="submit" class="border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm text-white">
                Save credentials
            </button>
        </form>
    }
</section>
