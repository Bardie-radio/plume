<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Sibling multi-root: ProjectReference when Logos checkout exists; else PackageReference. -->
    <LogosPath Condition="Exists('$(MSBuildThisFileDirectory)../logos/src')">$(MSBuildThisFileDirectory)../logos/src</LogosPath>
    <BardieLogosContractsVersion>0.1.0</BardieLogosContractsVersion>
    <BardieLogosChannelVersion>0.1.0</BardieLogosChannelVersion>
    <BardieLogosHostingVersion>0.1.0</BardieLogosHostingVersion>
  </PropertyGroup>
</Project>
