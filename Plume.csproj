<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Plume</RootNamespace>
    <AssemblyName>Plume</AssemblyName>
    <UserSecretsId>aspnet-Plume-a4730ed9-8a6e-44b4-8c6f-b8cbdb55c498</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bardie.Logos.Contracts" />
    <PackageReference Include="Bardie.Logos.Channel" />
    <PackageReference Include="Bardie.Logos.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="module.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Optional: build frontend assets on `dotnet publish` when Node is available. -->
  <Target Name="NpmBuild" BeforeTargets="Publish" Condition="Exists('package.json')">
    <Exec Command="npm ci" Condition="Exists('package-lock.json')" />
    <Exec Command="npm install" Condition="!Exists('package-lock.json')" />
    <Exec Command="npm run build" />
  </Target>

</Project>
